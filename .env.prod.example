# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored),
# fill in every CHANGE_ME, and keep it readable only by the deploy user:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Used both by compose (image tags, database login) and by the app container.

# --- Stack ---------------------------------------------------------------------
PROJECT_NAME=task_management
# Public host name. DNS must point at this server before the first start:
# Caddy obtains the HTTPS certificate for it automatically.
SITE_DOMAIN=CHANGE_ME.example.com
# Where the images come from and which versions run. "latest" follows master;
# pin a "sha-<commit>" tag to hold a version.
GHCR_OWNER=cristiangirlea
API_TAG=latest
WEB_TAG=latest

# --- Laravel -------------------------------------------------------------------
APP_NAME="Task Board"
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it: echo "base64:$(openssl rand -base64 32)"
# Changing it later breaks anything Laravel encrypted with the old key.
APP_KEY=CHANGE_ME
APP_URL=https://CHANGE_ME.example.com
# Links in invitation, verification and password-reset emails, and Stripe's return URLs.
FRONTEND_URL=https://CHANGE_ME.example.com
# The app and API share one origin, so browsers need no other.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (postgres service) -----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=task_management
DB_USERNAME=task_management
# Long and random: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

# --- Redis (redis service) -------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_STORE=redis
# Nothing is queued today (mail is sent inline). Switch to redis and add a
# `php artisan queue:work` service when a queued job is introduced.
QUEUE_CONNECTION=sync
# The API is token-authenticated; there are no server-side sessions.
SESSION_DRIVER=array

# --- Mail (Resend: 3,000 emails/month free) --------------------------------------
# Verify the sending domain in Resend first (SPF/DKIM records).
MAIL_MAILER=resend
RESEND_KEY=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@CHANGE_ME.example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Billing (Stripe) ---------------------------------------------------------------
# Test-mode keys (pk_test_/sk_test_) until you are ready to take real money.
STRIPE_KEY=CHANGE_ME
STRIPE_SECRET=CHANGE_ME
# Leave empty for the first start, then set it from
# `bin/prod exec app php artisan cashier:webhook --url=https://<SITE_DOMAIN>/api/stripe/webhook`
# (or the Stripe dashboard). While empty the webhook is switched off and
# upgrades never take effect.
STRIPE_WEBHOOK_SECRET=
# The Team plan: a recurring, monthly, per-unit Price.
STRIPE_PRICE_ID=CHANGE_ME
CASHIER_PATH=api/stripe
CASHIER_CURRENCY=usd
BILLING_FREE_SEATS=3
# Shown to customers; keep it equal to the Stripe Price.
BILLING_SEAT_PRICE_CENTS=800
