# Copy to .env (git-ignored) and adjust. Every variable the stack needs is here.
# This file is read by docker compose for interpolation AND passed as-is to the
# Laravel container (env_file), so Laravel settings live here too.

# --- Compose ------------------------------------------------------------------
PROJECT_NAME=task_management

# Where the app repos are, relative to this directory (sibling clones).
LARAVEL_CONTEXT=../task-management-app
NEXT_CONTEXT=../task-management-next-react
# This repo as seen FROM the app repos. Compose resolves `dockerfile:` relative
# to the build context, so the Dockerfiles in .docker/ are referenced through
# this path. Change it only if you cloned this repo under another name.
STACK_DIR=../task-management-docker

# Host port for nginx. The app, API and MCP endpoint are all served here.
NGINX_PORT=8080

# --- Database (postgres service) -----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=task_management
DB_USERNAME=task_management
DB_PASSWORD=secret

# --- Redis (redis service) ------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Laravel -----------------------------------------------------------------
APP_NAME="Task Management"
APP_ENV=local
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
# Seed demo data on start (login: demo@example.com / password).
SEED_DATABASE=true
# Browser origin the Next.js app is served from (nginx).
CORS_ALLOWED_ORIGINS=http://localhost:8080
