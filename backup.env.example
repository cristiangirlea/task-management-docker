# Off-site backup settings for the backup service. Copy to backup.env
# (git-ignored). Without it, dumps are kept on this server only, which does
# not survive losing the server.
#   cp backup.env.example backup.env && chmod 600 backup.env

# rclone reads a remote named OFFSITE from these variables; no config file needed.
# Backblaze B2 (10 GB free): create a bucket and an application key for it.
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=CHANGE_ME_key_id
RCLONE_CONFIG_OFFSITE_KEY=CHANGE_ME_application_key
# Cloudflare R2 (10 GB free, no egress fees) instead:
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com

# Bucket and folder the dumps go to.
BACKUP_REMOTE=offsite:CHANGE_ME-bucket/task-board

# Cron schedule (UTC) and retention.
BACKUP_SCHEDULE=15 3 * * *
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_DAYS=14
